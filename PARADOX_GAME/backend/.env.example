# Optional NASA API key. DEMO_KEY is used when this is not set (low rate limits).
NASA_API_KEY=DEMO_KEY

# Optional OpenAI key for AI-generated Copilot hints. Leave blank to use
# the built-in rule-based hint engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: set a custom account database path. By default, Windows uses
# %LOCALAPPDATA%\\PARADOX\\paradox_accounts.sqlite3.
# PARADOX_DB_PATH=

# ---------------------------------------------------------------------------
# AI Co-Pilot tutor chat (Ask AI button during missions)
# ---------------------------------------------------------------------------
# The tutor uses OPENAI_API_KEY / OPENAI_MODEL above. Keys stay on the backend.
# Optional: any OpenAI-compatible Chat Completions endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# Set TUTOR_PROVIDER=offline to force the offline study guide even with a key.
TUTOR_PROVIDER=openai

# ---------------------------------------------------------------------------
# Question generation + retrieval (optional; only used when OPENAI_API_KEY is set)
# ---------------------------------------------------------------------------
# Model for generating new validated mission questions when a student runs low.
# QUESTION_MODEL=gpt-4o-mini
# Embeddings for semantic duplicate detection and knowledge-base re-ranking.
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# Set EMBEDDINGS_PROVIDER=off to use only the built-in local similarity check.
EMBEDDINGS_PROVIDER=openai
